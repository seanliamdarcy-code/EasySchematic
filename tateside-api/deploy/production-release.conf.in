# Render @RELEASE_DIR@ to the absolute pinned release directory before installation.
# Install as release.conf for tateside-schematic-api.service; preserve private drop-ins.
[Service]
WorkingDirectory=@RELEASE_DIR@
ExecStart=
ExecStart=/usr/bin/node @RELEASE_DIR@/dist-tateside-api/tateside-api/src/server.js
Environment=TATESIDE_DATA_DIR=/var/lib/tateside-schematic
Environment=TATESIDE_DB_PATH=/var/lib/tateside-schematic/tateside.db
Environment=TATESIDE_SCHEMATIC_REPOSITORY_PATH=/var/lib/tateside-schematic/schematic-repository
Environment=JETBUILT_INDEX_PATH=/var/lib/tateside-schematic/jetbuilt-index.json
Environment=OPENAI_QUOTE_RESEARCH_CACHE_PATH=/var/lib/tateside-schematic/quote-research-cache.json
Environment=TATESIDE_API_HOST=172.17.0.1
Environment=TATESIDE_API_PORT=8788
Environment=TATESIDE_ALLOWED_ORIGIN=https://schematic.tateside.online
Environment=TATESIDE_REQUIRE_ACCESS_IDENTITY=1
Environment=TATESIDE_IMPORT_NORMALIZATION_ENABLED=1
Environment=TATESIDE_LIBRARY_AUDIT_ENABLED=1
Environment=TATESIDE_LIBRARY_DOCTOR_ENABLED=1
Environment=TATESIDE_LIBRARY_DOCTOR_GENERATION_ENABLED=1
Environment=TATESIDE_DYNAMIC_TAXONOMY_ENABLED=1
