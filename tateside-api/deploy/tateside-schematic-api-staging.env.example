# Staging-only environment file / systemd drop-in for tateside-schematic-api-staging
#
# This file is an example. Copy to a non-tracked location (e.g. /etc/systemd/system/tateside-schematic-api-staging.service.d/env.conf)
# and load via EnvironmentFile= or individual Environment= lines.
#
# Allowed (opt-in for staging feature testing only):
#   OPENAI_API_KEY=...
#   JETBUILT_API_KEY=...
#   JETBUILT_API_BASE_URL=...
#   OPENAI_QUOTE_IMPORT_MAX_FILE_BYTES=...
#   OPENAI_QUOTE_RESEARCH_CACHE_PATH=...
#   JETBUILT_INDEX_PATH=...
#   JETBUILT_INDEX_REFRESH_MS=...
#
# FORBIDDEN in staging (explicitly do not set these; SharePoint is disabled for isolation):
#   MS_ENTRA_TENANT_ID
#   MS_GRAPH_CLIENT_ID
#   MS_GRAPH_CLIENT_SECRET
#   TATESIDE_SHAREPOINT_SITE_ID
#   TATESIDE_SHAREPOINT_DRIVE_ID
#   TATESIDE_SHAREPOINT_ROOT_FOLDER_ID
#   MS_ENTRA_BASE_URL
#   MS_GRAPH_BASE_URL
#   Any other SharePoint / Microsoft Graph configuration.
#
# The unit file already sets the core TATESIDE_* isolation variables.
# Adding SharePoint variables here would defeat staging isolation.
# Production-only values must never be used on the staging service.
