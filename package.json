{
  "name": "easyschematic",
  "private": true,
  "license": "AGPL-3.0",
  "version": "0.39.0",
  "type": "module",
  "description": "Browser-based AV signal flow diagram tool for designing audio/video system schematics",
  "homepage": "https://easyschematic.live",
  "repository": {
    "type": "git",
    "url": "https://github.com/duremovich/EasySchematic.git"
  },
  "bugs": {
    "url": "https://github.com/duremovich/EasySchematic/issues"
  },
  "author": "duremovich",
  "keywords": [
    "av",
    "audio-video",
    "signal-flow",
    "schematic",
    "diagram",
    "broadcast",
    "av-integration",
    "dxf",
    "cad"
  ],
  "scripts": {
    "dev": "vite",
    "dev:full": "node tateside-api/dev-full.mjs",
    "generate-fallback": "npx tsx api/seed/generate-fallback.ts",
    "jetbuilt:export": "node scripts/jetbuilt-export.mjs",
    "jetbuilt:cleanup": "node scripts/jetbuilt-cleanup.mjs",
    "jetbuilt:spec-enrich": "node scripts/jetbuilt-spec-enrich.mjs",
    "jetbuilt:finalize": "node scripts/jetbuilt-finalize.mjs",
    "tateside:seed:jetbuilt": "node tateside-api/scripts/seed-jetbuilt-library.mjs",
    "jetbuilt:history:sync": "npm run tateside:api:build && node dist-tateside-api/tateside-api/src/jetbuiltHistoryCli.js",
    "jetbuilt:history:test": "npm run tateside:api:build && node --test tateside-api/jetbuiltHistory.local.test.mjs",
    "build": "npm run generate-fallback && tsc -b && vite build",
    "build:dev-reference": "typedoc",
    "lint": "eslint src tateside-api --max-warnings=0",
    "db:sync": "cd api && npm run seed:remote",
    "tateside:api": "npm run tateside:api:build && node dist-tateside-api/tateside-api/src/server.js",
    "tateside:api:build": "tsc -p tateside-api/tsconfig.json",
    "tateside:api:test:sharepoint": "npm run tateside:api:build && node --test tateside-api/sharePointGraph.local.test.mjs",
    "tateside:api:test:sharepoint-routes": "npm run tateside:api:build && node --test tateside-api/sharePointRoutes.local.test.mjs",
    "tateside:api:test:routes": "npm run tateside:api:build && node --test tateside-api/schematicRoutes.local.test.mjs",
    "tateside:api:test:storage": "npm run tateside:api:build && node --test tateside-api/schematicStore.local.test.mjs",
    "tateside:api:serve": "node dist-tateside-api/tateside-api/src/server.js",
    "tateside:mcp:library": "node dist-tateside-api/tateside-api/src/mcpServer.js",
    "tateside:mcp:http": "node dist-tateside-api/tateside-api/src/mcpHttpServer.js",
    "tateside:mcp:prepare-dev-db": "node dist-tateside-api/tateside-api/src/prepareMcpDevDb.js",
    "tateside:api:watch": "tsc -p tateside-api/tsconfig.json --watch --preserveWatchOutput",
    "tateside:api:watch:serve": "node --watch --watch-preserve-output dist-tateside-api/tateside-api/src/server.js",
    "tateside:api:smoke": "node tateside-api/smoke.mjs",
    "preview": "vite preview",
    "postinstall": "patch-package",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xyflow/react": "12.10.1",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.3",
    "jspdf": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "dxf-parser": "^1.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typedoc": "^0.28.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.73.0"
  }
}
